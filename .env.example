# Run `npm run init` to generate this file with random secrets. Never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
ZOKO_LOCAL_PORT=3000
ZOKO_PUBLIC_URL=https://zoko.example.com
ZOKO_DOMAIN=zoko.example.com
ACME_EMAIL=operator@example.com

# Generated by scripts/init-env.mjs. Use URL-safe hex for the database password.
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
# Compose overrides DATABASE_URL using POSTGRES_PASSWORD and its private network.
# For a native Node deployment, point this at your real PostgreSQL 16+ instance.
DATABASE_URL=postgresql://zoko:GENERATE_POSTGRES_PASSWORD@127.0.0.1:5432/zoko
ZOKO_ADMIN_TOKEN=GENERATE_ADMIN_TOKEN
ZOKO_ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY

# Agent-to-agent marketplace only: no platform inference key, model or default offer.
# Add exact seller-agent HTTPS hostnames after review, separated by commas.
# Empty by default: the control plane starts, but no endpoint is authorized to trade.
ZOKO_PROVIDER_HOSTS=
ZOKO_PROVIDER_TIMEOUT_MS=10000
# Commission deducted from each seller's successful sale; 1000 basis points = 10%.
ZOKO_PLATFORM_FEE_BPS=1000
ZOKO_QUOTE_TTL_SECONDS=60

# Zoko's dedicated service wallet signs locally and uses hosted Chronik endpoints.
# Generated by npm run init. Back up this secret with the database before funding.
# Never put a personal Cashtab recovery phrase or wallet secret in this service.
ZOKO_PAYMENTS_ENABLED=true
XEC_NETWORK=mainnet
XEC_WALLET_SEED_HEX=GENERATE_WALLET_SEED
# Ordered hosted failover for availability; endpoints are not an independent quorum.
CHRONIK_URLS=https://chronik.e.cash,https://chronik-native2.fabien.cash
XEC_CONFIRMATIONS=6
XEC_REQUIRE_FINALIZED=true
# Mainnet uses a built-in token-index canary. Set one explicitly for other networks.
XEC_TOKEN_PROBE_TXID=
# Mainnet uses a fixed chain anchor. Required for testnet/regtest only.
XEC_GENESIS_HASH=
# Fee amounts use integer nanoXEC; fee-rate settings use XEC per kB.
XEC_MAX_FEE_NANOS=100000000000
XEC_FEE_RATE=10.00
XEC_MAX_FEE_RATE=100.00
