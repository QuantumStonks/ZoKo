[Unit]
Description=ZoKo encrypted PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/zoko/encrypted-backup.sh
User=root
UMask=0077
Nice=10
CPUQuota=50%
MemoryMax=512M
TimeoutStartSec=300
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zoko/backups
NoNewPrivileges=true
